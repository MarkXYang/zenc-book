struct Point {
    x: int;
    y: int;
}

impl Point {
    fn add(self, other: Point) -> Point {
        return Point {
            x: self.x + other.x,
            y: self.y + other.y,
        };
    }
}

fn main() {
    let p1 = Point { x: 1, y: 2 };
    let p2 = Point { x: 3, y: 4 };

    let p3 = p1 + p2; // Automatically desugars to p1.add(p2)
    println "p3 = ({p3.x}, {p3.y})"; // Prints (4, 6)
}
