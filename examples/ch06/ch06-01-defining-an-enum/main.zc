// Section 6.1: Defining an Enum in Zen C

enum Status {
    Idle,
    Running,
    Finished,
    Error(int),
}

// 1. Defining methods on an enum using impl
impl Status {
    fn is_terminal(const self) -> bool {
        match *self {
            Status::Finished => { return true; },
            Status::Error(_) => { return true; },
            _ => { return false; },
        }
    }

    fn error_or_default(const self, default_code: int) -> int {
        match *self {
            Status::Error(code) => { return code; },
            _ => { return default_code; },
        }
    }
}

// 2. Kinds of enum variants
enum Shape {
    Circle(float),      // Single payload
    Rect(float, float), // Multi payload (tuple)
    Point,              // Unit variant
}

enum WebEvent {
    PageLoad,                   // Unit variant
    PageUnload,                 // Unit variant
    KeyPress(char),             // Single payload
    Click(int, int),            // Multi payload
    Paste(string),              // Single payload string
    ChangeColor(int, int, int), // Multi payload RGB
}

// 3. Generic Option preview
enum MyOption<T> {
    Some(T),
    None,
}

fn main() {
    println "=== Section 6.1: Defining and Instantiating Enums ===";

    // 1. Instantiating unit and payload variants
    let s1 = Status::Idle;
    let s2 = Status::Running;
    let s3 = Status::Finished;
    let s4 = Status::Error(500);

    // 2. Calling methods on enums
    println "Is s1 (Idle) terminal? {s1.is_terminal()}";
    println "Is s2 (Running) terminal? {s2.is_terminal()}";
    println "Is s3 (Finished) terminal? {s3.is_terminal()}";
    println "Is s4 (Error) terminal? {s4.is_terminal()}";
    println "s4 error code: {s4.error_or_default(0)}";
    println "s1 fallback error code: {s1.error_or_default(200)}";

    // 3. Multi-payload Shape enum
    let _c = Shape::Circle(10.5);
    let _r = Shape::Rect(20.0, 40.0);
    let _pt = Shape::Point;
    println "Instantiated Circle, Rect, and Point shapes successfully";

    // 4. WebEvent heterogeneous variants
    let _ev1 = WebEvent::PageLoad;
    let _ev2 = WebEvent::KeyPress('K');
    let _ev3 = WebEvent::Click(150, 300);
    let _ev4 = WebEvent::Paste("Copied text");
    let _ev5 = WebEvent::ChangeColor(255, 128, 64);
    println "Instantiated 5 distinct WebEvent variants successfully";

    // 5. Memory layout verification
    println "sizeof(Status) tagged union: {sizeof(Status)} bytes";
    println "sizeof(Shape) tagged union: {sizeof(Shape)} bytes";

    // 6. Generic enum preview
    let _opt_int = MyOption<int>::Some(42);
    let _opt_empty = MyOption<int>::None();
    println "Generic MyOption<int> instantiated successfully";

    println "Section 6.1 examples executed successfully!";
}
