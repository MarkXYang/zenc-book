// File: examples/ch20/ch20-03-misra-mode/main.zc
//
// Compile with: zc run -q --misra main.zc
// Or transpile: zc transpile --misra main.zc -o misra_clean.c

fn clamp_value(val: int, min_val: int, max_val: int) -> int {
    let result: int = val;
    if val < min_val {
        result = min_val;
    } else if val > max_val {
        result = max_val;
    } else {
        result = val;
    }
    return result;
}

fn compute_checksum(count: int) -> int {
    let sum: int = 0;
    let i: int = 0;
    while i < count {
        let clamped: int = clamp_value(i * 10, 20, 80);
        sum = sum + clamped;
        i = i + 1;
    }
    return sum;
}

fn main() -> int {
    let check: int = compute_checksum(10);
    let exit_code: int = 1;

    // Checksum verification:
    // i=0: clamp(0)  = 20
    // i=1: clamp(10) = 20
    // i=2: clamp(20) = 20
    // i=3: clamp(30) = 30
    // i=4: clamp(40) = 40
    // i=5: clamp(50) = 50
    // i=6: clamp(60) = 60
    // i=7: clamp(70) = 70
    // i=8: clamp(80) = 80
    // i=9: clamp(90) = 80
    // Sum = 20+20+20+30+40+50+60+70+80+80 = 470
    if check == 470 {
        exit_code = 0;
    } else {
        exit_code = 1;
    }

    return exit_code;
}
