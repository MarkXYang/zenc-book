@derive(Copy)
struct Vec2 {
    x: int;
    y: int;
}

impl Vec2 {
    fn new(x: int, y: int) -> Vec2 {
        return Vec2 { x: x, y: y };
    }

    fn add(self, other: Vec2) -> Vec2 {
        return Vec2 {
            x: self.x + other.x,
            y: self.y + other.y,
        };
    }

    fn sub(self, other: Vec2) -> Vec2 {
        return Vec2 {
            x: self.x - other.x,
            y: self.y - other.y,
        };
    }

    fn neg(self) -> Vec2 {
        return Vec2 {
            x: -self.x,
            y: -self.y,
        };
    }

    fn eq(self, other: Vec2) -> bool {
        return self.x == other.x && self.y == other.y;
    }

    fn neq(self, other: Vec2) -> bool {
        return !self.eq(other);
    }

    fn to_string(self) -> char* {
        let s = "({self.x}, {self.y})";
        return s;
    }
}

struct Matrix3x3 {
    data: int[9];
}

impl Matrix3x3 {
    fn identity() -> Matrix3x3 {
        return Matrix3x3 {
            data: [
            1, 0, 0,
            0, 1, 0,
            0, 0, 1,
            ],
        };
    }

    fn get(self, row: int, col: int) -> int {
        return self.data[row * 3 + col];
    }

    fn set(self, row: int, col: int, val: int) {
        self.data[row * 3 + col] = val;
    }
}

fn main() {
    let v1 = Vec2::new(3, 4);
    let v2 = Vec2::new(1, 2);

    let sum = v1 + v2;
    let diff = v1 - v2;
    let inv = -v1;

    println "v1 + v2 = {sum}, v1 - v2 = {diff}, -v1 = {inv}";
    println "v1 == v2: {v1 == v2}, v1 != v2: {v1 != v2}";

    v1 += v2;
    println "after v1 += v2: {v1}";

    let mat = Matrix3x3::identity();
    mat[1, 2] = 42;
    println "mat[0, 0] = {mat[0, 0]}, mat[1, 2] = {mat[1, 2]}";
}

