import "std/option.zc"
import "std/json.zc"

@derive(Copy, Clone, Eq, Debug)
struct Point {
    x: int;
    y: int;
}

struct Countdown {
    current: int;
}

impl Countdown {
    fn new(start: int) -> Countdown {
        return Countdown { current: start };
    }

    fn next(self) -> Option<int> {
        if self.current > 0 {
            let val = self.current;
            self.current -= 1;
            return Option<int>::Some(val);
        }
        return Option<int>::None();
    }

    fn iterator(self) -> Countdown {
        return self;
    }
}

struct Color {
    r: int;
    g: int;
    b: int;
}

impl Color {
    fn to_string(self) -> char* {
        let s = "rgb({self.r}, {self.g}, {self.b})";
        return s;
    }
}

@derive(ToJson, FromJson)
struct ServerConfig {
    host: char*;
    port: int;
    tls: bool;
}

fn main() {
    let p1 = Point { x: 10, y: 20 };
    let p2 = p1;
    let p3 = p1.clone();
    println "p1 == p2: {p1 == p2}, p1 == p3: {p1 == p3}";
    println "Debug output: {p1}";

    let primary = Color { r: 255, g: 128, b: 0 };
    println "Selected theme color: {primary}";

    let timer = Countdown::new(3);
    for n in timer {
        println "  T-minus {n}...";
    }

    let cfg = ServerConfig {
        host: "127.0.0.1",
        port: 8080,
        tls: true,
    };
    let json_val = cfg.to_json();
    let json_str = json_val.to_string();
    println "Serialized JSON: {json_str}";
}
